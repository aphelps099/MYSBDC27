    "story2Name": {
      "type": "string",
      "default": "Yarrow Goods"
    },
    "story2Value": {
      "type": "string",
      "default": "$138K"
    },
    "story2Unit": {
      "type": "string",
      "default": "raised"
    },
    "story2Headline": {
      "type": "string",
      "default": "Sales up 20%."
