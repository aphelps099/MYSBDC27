{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "mysbdc/stories",
  "title": "Success stories",
  "category": "mysbdc",
  "icon": "format-gallery",
  "description": "Editable NorCal SBDC homepage section. Change content here; the published layout retains its approved styling.",
