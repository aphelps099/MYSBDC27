{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "mysbdc/about-story",
  "title": "About · Client story",
  "category": "mysbdc",
  "icon": "admin-site-alt3",
  "description": "Editable About page section. Reorder sections and edit content while preserving the layout.",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "A business. A person. A possibility."
    },
    "quote": {
      "type": "string",
      "default": "The SBDC helped me early on to get into the dream fund and receive a grant!"
    },
    "clientName": {
      "type": "string",
      "default": "Laila O’Boyle"
    },
    "attribution": {
      "type": "string",
      "default": "Founder, The Early Rise · San Francisco"
    },
    "linkText": {
      "type": "string",
      "default": "Read Laila’s story"
    },
    "storyUrl": {
      "type": "string",
      "default": "https://www.norcalsbdc.org/shared/client-stories/from-oven-to-online-local-baker-scales-to-global-reach/"
    },
    "imageUrl": {
      "type": "string",
      "default": "https://www.norcalsbdc.org/wp-content/uploads/sites/13/2026/02/Laila-Pic-1200x1181.png"
    },
    "imageAlt": {
      "type": "string",
      "default": "Laila O’Boyle smiling behind freshly baked bread at The Early Rise"
    }
  },
  "supports": {
    "html": false,
    "customClassName": false,
    "multiple": false
  },
  "editorScript": "mysbdc-home-blocks-editor",
  "editorStyle": "mysbdc-home-blocks-editor",
  "style": "mysbdc-about"
}
